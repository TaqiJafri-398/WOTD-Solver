<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.taqijafri.wotdsolver"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Needed on Android 11+ so the camera app is visible to queryIntentActivities -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.WotdSolver.Dark"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.ResultActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ui.ManualInputActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ui.EditDetectionActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false" />

        <provider
            android:name=".ScreenshotProvider"
            android:authorities="com.taqijafri.wotdsolver.screenshots"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
