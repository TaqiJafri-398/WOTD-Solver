<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WotdSolver.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:colorAccent">@color/binance_yellow</item>
        <item name="android:colorPrimary">@color/bg_dark</item>
        <item name="android:colorPrimaryDark">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:editTextColor">@color/text_dark</item>
