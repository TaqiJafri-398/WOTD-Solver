        <item name="android:editTextColor">@color/text_light</item>
        <item name="android:editTextBackground">@color/card_light</item>
        <item name="cardBackground">@color/surface_light</item>
        <item name="cardStroke">@color/stroke_light</item>
        <item name="accentSoft">@color/accent_soft</item>
    </style>
</resources>
